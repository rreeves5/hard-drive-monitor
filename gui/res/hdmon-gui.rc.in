// hdmon-gui.exe resources: icon, manifest (requireAdministrator), version info.
#include <winresrc.h>

appicon ICON "@CMAKE_CURRENT_SOURCE_DIR@/gui/res/hdmon.ico"

#define wxUSE_NO_MANIFEST 1
#include "wx/msw/wx.rc"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/hdmon-gui.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Richard Reeves"
      VALUE "FileDescription", "Hard Drive Monitor"
      VALUE "FileVersion", "Beta V @PROJECT_VERSION@"
      VALUE "InternalName", "hdmon-gui"
      VALUE "LegalCopyright", "(c) 2026 Richard Reeves"
      VALUE "OriginalFilename", "hdmon-gui.exe"
      VALUE "ProductName", "Hard Drive Monitor"
      VALUE "ProductVersion", "Beta V @PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
